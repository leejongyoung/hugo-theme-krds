{{- $items := slice -}}
{{- range where site.RegularPages "Params.searchExclude" "ne" true -}}
  {{- $kind := cond (eq .Section "blog") "post" "page" -}}
  {{- $date := "" -}}
  {{- if eq $kind "post" }}{{ $date = .Date.Format "2006.01.02" }}{{ end -}}
  {{- $items = $items | append (dict "t" .Title "u" .RelPermalink "k" $kind "d" $date "g" (.Params.tags | default (slice)) "l" (.Description | default .Summary | plainify) "c" (.Plain | truncate 3000)) -}}
{{- end -}}
{{- $items | jsonify -}}
