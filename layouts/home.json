{{- $items := slice -}}
{{- range where site.RegularPages "Params.searchExclude" "ne" true -}}
  {{- $items = $items | append (dict "title" .Title "url" .RelPermalink "summary" (.Summary | plainify) "content" (.Plain | truncate 5000) "tags" (.Params.tags | default (slice)) "date" (.Date.Format "2006-01-02")) -}}
{{- end -}}
{{- $items | jsonify -}}
