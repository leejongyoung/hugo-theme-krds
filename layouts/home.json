{{- $items := slice -}}
{{- $sentence := partial "search-sentence.html" . -}}
{{- range where site.RegularPages "Params.searchExclude" "ne" true -}}
  {{- $kind := cond (eq .Section "blog") "post" "page" -}}
  {{- $date := "" -}}
  {{- if eq $kind "post" }}{{ $date = .Date.Format "2006.01.02" }}{{ end -}}
  {{- /* 문장 검색용 소제목별 본문(s). h2·h3 앞에서 나누고 한 절은 4000자까지만 담는다. */ -}}
  {{- $sections := slice -}}
  {{- if $sentence -}}
    {{- $marked := replaceRE `<h[23]` "\x1e${0}" .Content -}}
    {{- range $part := split $marked "\x1e" -}}
      {{- $head := "" -}}{{- $anchor := "" -}}{{- $body := $part -}}
      {{- if hasPrefix $part "<h" -}}
        {{- with findRESubmatch `(?s)^<h[23]([^>]*)>(.*?)</h[23]>` $part 1 -}}
          {{- $g := index . 0 -}}
          {{- $head = index $g 2 | plainify | htmlUnescape | strings.TrimSpace -}}
          {{- with findRESubmatch `id="([^"]*)"` (index $g 1) 1 }}{{ $anchor = index (index . 0) 1 }}{{ end -}}
          {{- $body = strings.TrimPrefix (index $g 0) $part -}}
        {{- end -}}
      {{- end -}}
      {{- $text := $body | plainify | htmlUnescape | replaceRE `\s+` " " | strings.TrimSpace | truncate 4000 "" -}}
      {{- if gt (strings.RuneCount $text) 14 }}{{ $sections = $sections | append (dict "h" $head "a" $anchor "c" $text) }}{{ end -}}
    {{- end -}}
  {{- end -}}
  {{- $items = $items | append (dict "t" .Title "u" .RelPermalink "k" $kind "d" $date "g" (.Params.tags | default (slice)) "l" (.Description | default .Summary | plainify) "c" (.Plain | truncate 3000) "s" $sections) -}}
{{- end -}}
{{- $items | jsonify -}}
